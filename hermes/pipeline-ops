#!/bin/bash
# pipeline-ops: Hermes's only door to Render, through the dashboard (web/ops-api.js).
#   pipeline-ops services               status and last deploy of each pipeline service
#   pipeline-ops run <cron job>         start probate-slice-a|b|c or probate-fast-desk now
#   pipeline-ops deploy <service>       redeploy a pipeline service
#   pipeline-ops logs <service> [n]     last n log lines (default 100)
#   pipeline-ops db <view> [query]      read-only database views: summary, records (dataset=, q=),
#                                       history (dataset=, key=), files (q=), file (path=), saves, syncs
#   pipeline-ops task open "<title>"    record a task the owner gave you; prints its id
#   pipeline-ops task progress <id> "<where it stands>"
#   pipeline-ops task done <id> "<what was done, with numbers>"
#   pipeline-ops task failed <id> "<why, and what is needed>"
#   pipeline-ops tasks                  the task list (open ones first to check)
set -eu
BASE="${DASHBOARD_URL:-https://probate-dashboard.onrender.com}"
name() { [[ "${1:-}" =~ ^[a-z0-9-]{1,40}$ ]] || { echo "bad service name" >&2; exit 2; }; }
# The key comes from the private file boot.sh writes (Hermes doesn't hand its environment to commands).
KEY="${API_SERVER_KEY:-$(cat "${HERMES_HOME:-/opt/data}/.probate/ops_key" 2>/dev/null)}"
[ -n "$KEY" ] || { echo "pipeline-ops: no key (restart the probate-hermes service)" >&2; exit 2; }
call() { curl -sS --max-time 120 -H "Authorization: Bearer $KEY" "$@"; echo; }
case "${1:-}" in
  services) call "$BASE/api/ops/services" ;;
  run|deploy) name "${2:-}"; call -H 'Content-Type: application/json' -d "{\"service\":\"$2\"}" "$BASE/api/ops/$1" ;;
  logs) name "${2:-}"; call "$BASE/api/ops/logs?service=$2&limit=${3:-100}" ;;
  db) [[ "${2:-}" =~ ^[a-zA-Z]{1,20}$ ]] || { echo "bad view" >&2; exit 2; }; call -G "$BASE/api/ops/db/$2" ${3:+--data "$3"} ;;
  tasks) call "$BASE/api/ops/tasks" ;;
  task)
    case "${2:-}" in
      open) body=$(python3 -c 'import json,sys; print(json.dumps({"action":"open","title":sys.argv[1]}))' "${3:?title}") ;;
      progress|done|failed) body=$(python3 -c 'import json,sys; print(json.dumps({"action":sys.argv[1],"id":sys.argv[2],"result":sys.argv[3]}))' "$2" "${3:?task id}" "${4:-}") ;;
      *) echo "task open|progress|done|failed" >&2; exit 2 ;;
    esac
    call -H 'Content-Type: application/json' -d "$body" "$BASE/api/ops/task" ;;
  *) sed -n '2,13p' "$0"; exit 2 ;;
esac
